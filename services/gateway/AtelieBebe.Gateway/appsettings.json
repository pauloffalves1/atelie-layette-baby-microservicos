{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // 4200 is the monolith's client/ (unrelated dev instance on this same machine); 4210 is the
    // microfrontend shell's dev port (picked to avoid clashing with that same 4200).
    "AllowedOrigins": [ "http://localhost:4200", "http://localhost:4210" ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-login-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/login" },
        "RateLimiterPolicy": "auth"
      },
      "identity-reset-password-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/reset-password" },
        "RateLimiterPolicy": "auth"
      },
      "identity-delete-account-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/delete-account" },
        "RateLimiterPolicy": "auth"
      },
      "identity-verify-email-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/verify-email" },
        "RateLimiterPolicy": "auth"
      },
      "identity-resend-verification-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/resend-verification" },
        "RateLimiterPolicy": "auth"
      },
      "identity-admin-auth-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/admin/auth/{**catch-all}" }
      },
      "identity-admin-login-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/admin/auth/login" },
        "RateLimiterPolicy": "auth"
      },
      "identity-admin-2fa-verify-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/admin/auth/2fa/verify" },
        "RateLimiterPolicy": "auth"
      },
      "identity-admin-customers-route": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/admin/customers/{**catch-all}" }
      },

      "catalog-products-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "catalog-admin-products-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/products/{**catch-all}" }
      },
      "catalog-gallery-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/gallery-images/{**catch-all}" }
      },
      "catalog-admin-gallery-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/gallery-images/{**catch-all}" }
      },
      "catalog-site-images-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/site-images/{**catch-all}" }
      },
      "catalog-admin-site-images-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/site-images/{**catch-all}" }
      },
      "catalog-uploads-route": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/uploads/{**catch-all}" }
      },

      "orders-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "orders-lookup-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/orders/lookup" },
        "RateLimiterPolicy": "auth"
      },
      "orders-admin-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/admin/orders/{**catch-all}" }
      },
      "orders-cart-sync-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/cart-sync" }
      },
      "orders-coupons-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/coupons/{**catch-all}" }
      },
      "orders-coupons-validate-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/coupons/validate" },
        "RateLimiterPolicy": "auth"
      },
      "orders-admin-coupons-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/admin/coupons/{**catch-all}" }
      },
      "orders-payments-route": {
        "ClusterId": "orders",
        "Match": { "Path": "/api/payments/{**catch-all}" }
      },

      "backoffice-contact-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/contact" }
      },
      "backoffice-admin-contact-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/admin/contact-messages/{**catch-all}" }
      },
      "backoffice-newsletter-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/newsletter/{**catch-all}" }
      },
      "backoffice-admin-newsletter-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/admin/newsletter/{**catch-all}" }
      },
      "backoffice-audit-log-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/admin/audit-log" }
      },
      "backoffice-dashboard-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/admin/dashboard" }
      },
      "backoffice-sitemap-route": {
        "ClusterId": "backoffice",
        "Match": { "Path": "/api/sitemap.xml" }
      }
    },
    "Clusters": {
      "identity": { "Destinations": { "d1": { "Address": "http://identity:8080" } } },
      "catalog": { "Destinations": { "d1": { "Address": "http://catalog:8080" } } },
      "orders": { "Destinations": { "d1": { "Address": "http://orders:8080" } } },
      "backoffice": { "Destinations": { "d1": { "Address": "http://backoffice:8080" } } }
    }
  }
}
