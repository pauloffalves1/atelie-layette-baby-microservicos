{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/data/catalog.db"
  },
  "Jwt": {
    "PublicKeyPath": "/keys/jwt-public.pem",
    "Issuer": "AtelieBebe.Identity",
    "Audience": "AtelieBebe.Client"
  },
  "Uploads": {
    "Path": "/data/uploads",
    "PublicPath": "/api/uploads"
  },
  "Services": {
    "Orders": "http://orders:8080"
  },
  "RabbitMq": {
    "HostName": "rabbitmq",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "Exchange": "atelie.events"
  }
}
