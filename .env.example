# Copy to .env and fill in real values. Never commit .env — it's gitignored.

# RabbitMQ credentials (never use the rabbitmq:management image's guest/guest default in production)
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Seeded once by each service's DbInitializer on first start
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Orders service — PagBank payment integration
PAGBANK_TOKEN=
PAGBANK_SANDBOX=false

# Public origin of the site — used for CORS (Gateway) and links in outgoing notifications
PUBLIC_URL=https://layettebaby.com.br

# Notifications worker — WhatsApp Business Cloud API (leave blank if not yet configured)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_PHONE=

# Notifications worker — Resend transactional email (leave blank if not yet configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
